{
  "name": "morphapi",
  "private": true,
  "version": "0.1.0",
  "description": "MorphAPI — hybrid AI+AST baseline for MorphPay scaffolding-hallucination demo",
  "workspaces": [
    "packages/*",
    "fixtures/*",
    "baselines/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build -w @morphapi/core && npm run build -w morphpay-v1 && npm run build -w morphpay-v2 && npm run build -w plaid-link-v1 && npm run build -w plaid-link-v2 && npm run build -w openai-chat-v0 && npm run build -w openai-chat-v1 && npm run build -w stripe-charge-v1 && npm run build -w stripe-charge-v2 && npm run build -w stripe-errors-v1 && npm run build -w stripe-errors-v2 && npm run build -w auth-jwt-v1 && npm run build -w auth-jwt-v2 && npm run build -w users-list-v1 && npm run build -w users-list-v2 && npm run build -w aws-s3-v1 && npm run build -w aws-s3-v2 && npm run build -w mail-send-v1 && npm run build -w mail-send-v2 && npm run build -w webhook-auth-v1 && npm run build -w webhook-auth-v2 && npm run build -w events-gateway-v1 && npm run build -w events-gateway-v2",
    "demo": "bash scripts/demo.sh",
    "demo:plaid": "bash scripts/demo-plaid.sh",
    "demo:openai": "bash scripts/demo-openai.sh",
    "demo:stripe": "bash scripts/demo-stripe.sh",
    "demo:stripe-errors": "bash scripts/demo-stripe-errors.sh",
    "demo:auth": "bash scripts/demo-auth.sh",
    "demo:envelope": "bash scripts/demo-envelope.sh",
    "demo:async": "bash scripts/demo-async.sh",
    "demo:mail": "bash scripts/demo-mail.sh",
    "demo:hmac": "bash scripts/demo-hmac.sh",
    "demo:discriminator": "bash scripts/demo-discriminator.sh",
    "demo:llm-only": "npm run start -w @morphapi/baseline-llm-only",
    "demo:hybrid": "npm run start -w @morphapi/baseline-hybrid",
    "demo:plaid-llm-only": "npm run start -w @morphapi/baseline-plaid-llm-only",
    "demo:plaid-hybrid": "npm run start -w @morphapi/baseline-plaid-hybrid",
    "demo:openai-llm-only": "npm run start -w @morphapi/baseline-openai-llm-only",
    "demo:openai-hybrid": "npm run start -w @morphapi/baseline-openai-hybrid",
    "demo:openai-ast": "npm run start -w @morphapi/baseline-openai-ast",
    "demo:async-ast": "npm run start -w @morphapi/baseline-async-ast",
    "demo:envelope-ast": "npm run start -w @morphapi/baseline-envelope-ast",
    "demo:mail-ast": "npm run start -w @morphapi/baseline-mail-ast",
    "demo:stripe-llm-only": "npm run start -w @morphapi/baseline-stripe-llm-only",
    "demo:stripe-hybrid": "npm run start -w @morphapi/baseline-stripe-hybrid",
    "demo:stripe-errors-llm-only": "npm run start -w @morphapi/baseline-stripe-errors-llm-only",
    "demo:stripe-errors-hybrid": "npm run start -w @morphapi/baseline-stripe-errors-hybrid",
    "demo:auth-llm-only": "npm run start -w @morphapi/baseline-auth-llm-only",
    "demo:auth-hybrid": "npm run start -w @morphapi/baseline-auth-hybrid",
    "demo:envelope-llm-only": "npm run start -w @morphapi/baseline-envelope-llm-only",
    "demo:envelope-hybrid": "npm run start -w @morphapi/baseline-envelope-hybrid",
    "demo:async-llm-only": "npm run start -w @morphapi/baseline-async-llm-only",
    "demo:async-hybrid": "npm run start -w @morphapi/baseline-async-hybrid",
    "demo:mail-llm-only": "npm run start -w @morphapi/baseline-mail-llm-only",
    "demo:mail-hybrid": "npm run start -w @morphapi/baseline-mail-hybrid",
    "demo:hmac-llm-only": "npm run start -w @morphapi/baseline-hmac-llm-only",
    "demo:hmac-hybrid": "npm run start -w @morphapi/baseline-hmac-hybrid",
    "demo:discriminator-llm-only": "npm run start -w @morphapi/baseline-discriminator-llm-only",
    "demo:discriminator-hybrid": "npm run start -w @morphapi/baseline-discriminator-hybrid",
    "demo:ui": "npm run dev -w @morphapi/demo-ui",
    "graph:cli": "node scripts/graph-run.mjs",
    "eval:matrix": "node scripts/eval-matrix.mjs",
    "eval:repair-reports": "node scripts/attach-llm-repair-reports.mjs && node scripts/attach-hybrid-repair-reports.mjs && node scripts/render-repair-report.mjs --all-pilots",
    "eval:repair-pdf": "node scripts/render-repair-pdf.mjs --mail",
    "typecheck:v1": "npm run typecheck -w client-v1",
    "typecheck:llm-only": "npm run typecheck -w @morphapi/baseline-llm-only",
    "typecheck:hybrid": "npm run typecheck -w @morphapi/baseline-hybrid"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "pdfkit": "^0.20.2"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.17.6"
  }
}
