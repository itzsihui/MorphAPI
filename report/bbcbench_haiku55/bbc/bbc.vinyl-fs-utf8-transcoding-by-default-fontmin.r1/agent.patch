+/**
+ * vinyl-fs 4 returns streams built on `streamx`, which tears down the
+ * destination of a pipe by calling `destroy()` on it when the source fails.
+ * The plugins here are `through2` 2.x streams, which have no `destroy()`,
+ * so that teardown throws. Bridge through a Node core stream, which has
+ * `destroy()`, and forward source errors to it.
+ *
+ * @param {Stream} src stream returned by vinyl-fs
+ * @return {Stream} Node core stream carrying the same files
+ * @api private
+ */
+function toNodeStream(src) {
+    var bridge = new PassThrough({objectMode: true});
+
+    src.on('error', function (err) {
+        bridge.destroy(err);
+    });
+
+    return src.pipe(bridge);
+}
+
+/**
+ * Font files are binary. vinyl-fs 4 transcodes file contents as UTF-8 by
+ * default, which corrupts them on read and write, so disable transcoding
+ * unless the caller explicitly provides an `encoding` option.
+ *
+ * @param {Arguments|Array} args arguments of `src()` or `dest()`
+ * @return {Array} arguments with the options object defaulting to `encoding: false`
+ * @api private
+ */
+function binaryArgs(args) {
+    var list = Array.prototype.slice.call(args);
+    var opts = list[1] || {};
+
+    list[1] = _.assign({encoding: false}, opts);
+
+    return list;
+}
