+var applyEachSeries = function (fns, req, callback) {
+  var index = 0;
+  var next = function (err) {
+    if (err) {
+      return callback(err);
+    }
+    if (index >= fns.length) {
+      return callback(null);
+    }
+    var fn = fns[index++];
+    var called = false;
+    fn(req, function (err) {
+      if (called) {
+        throw new Error('Callback was already called.');
+      }
+      called = true;
+      next(err);
+    });
+  };
+  next(null);
+};
