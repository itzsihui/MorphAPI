 Promise = require('bluebird')
 request = require('request')
-requestAsync = Promise.promisify(request)
+# The request callback is (error, response, body). Bluebird 2.x resolved the
+# promise with the first success value (the response) only. Bluebird 3.x
+# resolves with all success values as an array unless told otherwise, so
+# `multiArgs` is set to keep `.spread (response)` receiving the response.
+requestAsync = Promise.promisify(request, multiArgs: true)
 url = require('url')
 _ = require('lodash')
 rindle = require('rindle')
