diff --git a/src/redisSentinel.js b/src/redisSentinel.js
index 567502a..6c62a6d 100644
--- a/src/redisSentinel.js
+++ b/src/redisSentinel.js
@@ -43,7 +43,8 @@ function RedisSentinel(sentinels, options) {
     watchedNames:       null,
   };
 
-  this.options = util._.extend(defaults, options);
+  // _.assign (own enumerable props only), matching lodash 3's _.extend. Lodash 4's _.extend is assignIn.
+  this.options = util._.assign(defaults, options);
 
   // Make sure that the outside can't inject a test client:
   delete this.options._testClient;
@@ -218,8 +219,10 @@ RedisSentinel.prototype._handleErrorAndReconnect = function _handleErrorAndRecon
 
 
 RedisSentinel.prototype._dedupeSentinels = function _dedupeSentinels() {
-  // Dedupe the list based on "host(lowercase):port":
-  this.sentinels = util._.uniq(this.sentinels, function (conf) {
+  // Dedupe the list based on "host(lowercase):port".
+  // Lodash 4's _.uniq takes no iteratee (that's 3.x); the iteratee form is _.uniqBy.
+  // Lodash 4 passes only the element to the iteratee (3.x also passed index and array); this one only uses the element.
+  this.sentinels = util._.uniqBy(this.sentinels, function (conf) {
     return conf.host.toLowerCase() + ":" + conf.port;
   });
 };
