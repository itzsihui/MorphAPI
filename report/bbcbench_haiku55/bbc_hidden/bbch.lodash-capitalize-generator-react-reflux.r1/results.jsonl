es (all under `src/`):**\n- `actions/index.js`, `store/index.js`: 4 calls `_.capitalize(` → `_.upperFirst(`.\n- Templates in `actions/templates/`, `component/templates/`, `store/templates/` (`.js`, `.jsx`, `.coffee`, `.cjsx`): `lodash.capitalize(` → `lodash.upperFirst(`. The `lodash` object is passed into every template context, so these resolve correctly.\n\nNo other lodash functions are used in the project, so `capitalize` was the only behaviour that changed. `package.json`, lockfiles and `node_modules` are untouched.\n\n**Not verified:**\n- I did not run the test suite, since it isn't in the workspace.\n- I didn't run lodash 3.8.0 to compare outputs, because it isn't installed here. The 3.x behaviour comes from my knowledge of its source.\n\n`git status` already showed deleted test files and templates before I started. I left those alone.","ttft_ms":12483,"type":"result","duration_ms":26402,"uuid":"5a2f828d-ae68-47cd-97b5-38f98d1196f0","begun_message_ids":["msg_011ChMSv5RBmQ8gX89kNZ9k7","msg_011ChMSw3YrFVcG1PFXdfM3D","msg_011ChMSw8tpZKBL9gxy9g3wL","msg_011ChMSwLAytQAm1AvbyfxjZ","msg_011ChMSwno7M7tR8XmG2G7Ne"],"ttft_stream_ms":456,"time_to_request_ms":102,"time_to_request_phases_ms":{"other":6,"system_prompt":8,"resume_other":0,"process_user_input":23,"input_attachments":15,"input_hooks":3,"conversation_append":1,"transcript_persist":3,"tool_pool_refresh":0,"init_message":5,"init_frame_send":1,"engine_pickup":2,"loop_entry":4,"message_prep":1,"model_config_wait":1,"autocompact":2,"request_announcements":5,"query_setup":1,"model_gates":0,"tool_schema_build":8,"message_normalization":3,"client_creation":3,"request_build":7},"turn_start_resume_kind":"none","process_turn_index":0,"time_to_request_loop_lag_ms":2,"time_to_request_cpu_ms":106,"time_to_request_major_faults":0,"input_attachments_detail":{"slowest_producer":"skill_listing","slowest_producer_ms":7,"cpu_ms":15,"major_faults":0,"setup_ms":0,"prompt_producers_ms":0,"ambient_start_ms":4,"ambient_wait_ms":6,"rend