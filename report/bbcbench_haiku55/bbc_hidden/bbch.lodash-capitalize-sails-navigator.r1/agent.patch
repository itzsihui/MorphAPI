 do ->
   _ = require('lodash')
 
+  # lodash 4 changed three helpers this module used, so these reproduce the
+  # lodash 3.10 results that the controller names are built from:
+  #  - _.capitalize (v4 also lower-cases the rest of the string)
+  #  - _.camelCase (v4 keeps digits inside words: 'api2users' -> 'Api2users',
+  #    v3 split them out: 'api2users' -> 'Api2Users')
+  #  - _.deburr (v4 also transliterates Latin Extended-A and strips combining marks)
+  _capitalize = (string)->
+    string = if string? then String(string) else ''
+    string and string.charAt(0).toUpperCase() + string.slice(1)
+
+  _upperChar = '[A-Z\\xc0-\\xd6\\xd8-\\xde]'
+  _lowerChars = '[a-z\\xdf-\\xf6\\xf8-\\xff]+'
+  _wordPattern = RegExp("#{_upperChar}+(?=#{_upperChar}#{_lowerChars})|#{_upperChar}?#{_lowerChars}|#{_upperChar}+|[0-9]+", 'g')
+
+  _camelCase = (string)->
+    string = if string? then String(string) else ''
+    # lodash 3 only transliterated Latin-1 letters
+    string = string.replace(/[\xc0-\xff]/g, (char)-> _.deburr(char))
+    words = string.replace(/['\u2019]/g, '').match(_wordPattern) or []
+    result = ''
+    for word, index in words
+      word = word.toLowerCase()
+      result += if index then _capitalize(word) else word
+    return result
+
   _config =
     # controller: null
     pathToRecordFormat: '*/:id' #'route/:id/:slug'
