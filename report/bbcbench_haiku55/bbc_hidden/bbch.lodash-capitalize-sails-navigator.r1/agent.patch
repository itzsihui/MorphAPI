-        _.extend(navigator._routes, restFulRoutes)
+        _.assign(navigator._routes, restFulRoutes)
     else
       restFulRoutes = _makeRestfulRoutes(filter, controllerName, _currentRoute)
-      _.extend(navigator._routes, restFulRoutes)
+      _.assign(navigator._routes, restFulRoutes)
 
