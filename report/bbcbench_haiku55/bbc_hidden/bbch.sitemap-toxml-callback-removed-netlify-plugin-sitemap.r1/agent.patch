+    // sitemap@3 threw on invalid URL options; sitemap@4 only warns unless told to throw
+    const sitemap = createSitemap({ hostname, cacheTime: DEFAULT_CACHE_TIME, urls, level: ErrorLevel.THROW })
+    // sitemap@4 normalizes `lastmodfile` to a full ISO timestamp, while sitemap@3 wrote the
+    // date only (YYYY-MM-DD). Restore the date-only format on the normalized entries.
+    for (const item of sitemap.urls.values()) {
+      if (item.lastmodfile) {
+        item.lastmod = formatLastmod(item.lastmodfile)
+      }
+    }
+    // sitemap@4 `toXML` is synchronous and no longer accepts a callback
+    const xml = sitemap.toXML()
     return { sitemap, xml }
